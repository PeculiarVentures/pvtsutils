{
  "name": "@peculiar/utils",
  "version": "2.0.3",
  "description": "Modern byte, encoding, converter registry, and PEM utilities for TypeScript projects.",
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.cts",
  "exports": {
    ".": {
      "module": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "default": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    },
    "./bytes": {
      "module": {
        "types": "./build/bytes/index.d.mts",
        "default": "./build/bytes/index.mjs"
      },
      "default": {
        "types": "./build/bytes/index.d.cts",
        "default": "./build/bytes/index.cjs"
      }
    },
    "./encoding": {
      "module": {
        "types": "./build/encoding/index.d.mts",
        "default": "./build/encoding/index.mjs"
      },
      "default": {
        "types": "./build/encoding/index.d.cts",
        "default": "./build/encoding/index.cjs"
      }
    },
    "./encoding/*": {
      "module": {
        "types": "./build/encoding/*.d.mts",
        "default": "./build/encoding/*.mjs"
      },
      "default": {
        "types": "./build/encoding/*.d.cts",
        "default": "./build/encoding/*.cjs"
      }
    },
    "./converters": {
      "module": {
        "types": "./build/converters/index.d.mts",
        "default": "./build/converters/index.mjs"
      },
      "default": {
        "types": "./build/converters/index.d.cts",
        "default": "./build/converters/index.cjs"
      }
    },
    "./pem": {
      "module": {
        "types": "./build/pem/index.d.mts",
        "default": "./build/pem/index.mjs"
      },
      "default": {
        "types": "./build/pem/index.d.cts",
        "default": "./build/pem/index.cjs"
      }
    },
    "./legacy": {
      "module": {
        "types": "./build/legacy/index.d.mts",
        "default": "./build/legacy/index.mjs"
      },
      "default": {
        "types": "./build/legacy/index.d.cts",
        "default": "./build/legacy/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/**/*.mjs",
    "build/**/*.cjs",
    "build/**/*.d.mts",
    "build/**/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "publish:manual": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm publish --ignore-scripts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "keywords": [
    "typescript",
    "utils",
    "buffer",
    "bytes",
    "convert",
    "encoding",
    "base64",
    "base64url",
    "hex",
    "utf8",
    "utf16",
    "pem",
    "pki",
    "peculiar"
  ],
  "author": "PeculiarVentures",
  "contributors": [
    "Miroshin Stepan<microshine@mail.ru>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/pvtsutils"
  },
  "bugs": {
    "url": "https://github.com/PeculiarVentures/pvtsutils/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/pvtsutils#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}